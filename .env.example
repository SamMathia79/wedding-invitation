# ==========================================================
# Samer & Rafca Wedding Invitation — Environment Variables
# ==========================================================

# 1. Public Site URL (used for WhatsApp OpenGraph preview links)
NEXT_PUBLIC_SITE_URL=https://samer-and-rafca.vercel.app

# 2. Admin Credentials (defaults to SamRebecca2027 / SamRebecca@2027 if omitted)
ADMIN_USERNAME=SamRebecca2027
ADMIN_PASSWORD=SamRebecca@2027
ADMIN_SESSION_SECRET=change-this-to-a-random-long-secret-in-production

# 3. Database: Vercel Postgres / Neon (auto-populates when linked in Vercel Dashboard -> Storage)
# Leave blank locally to use automatic local JSON storage (data/wedding-db.json)
DATABASE_URL=

# 4. Media Uploads: Vercel Blob (auto-populates when linked in Vercel Dashboard -> Storage)
# Leave blank locally to save uploaded images & audio to public/uploads/
BLOB_READ_WRITE_TOKEN=
